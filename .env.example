# ==========================================
# Frontend Environment Variables (.env.local)
# ==========================================

# Optional: Disable Hot Module Replacement (HMR) in Vite (set to 'true' to disable)
DISABLE_HMR=

# Optional: Gemini API Key if testing AI Studio generated code features
GEMINI_API_KEY=


# ==========================================
# Backend Environment Variables (server/.env)
# ==========================================

# Required: The port the backend server runs on
PORT=

# Required: PostgreSQL connection string (e.g., postgres://user:pass@localhost:5432/dbname)
DATABASE_URL=

# Required: Secret key for signing JSON Web Tokens
JWT_SECRET=

# ------------------------------------------
# S3 Configuration (e.g., ArvanCloud, AWS)
# ------------------------------------------

# Optional: S3 Region (e.g., us-east-1, or 'default' for ArvanCloud)
S3_REGION=

# Required if using S3: S3 Access Key ID
S3_ACCESS_KEY=

# Required if using S3: S3 Secret Access Key
S3_SECRET_KEY=

# Optional: Custom S3 Endpoint URL (Required for non-AWS providers like ArvanCloud)
S3_ENDPOINT=

# Required if using S3: The name of the S3 bucket to store files
S3_BUCKET_NAME=
